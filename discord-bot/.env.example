# Discord bot token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# Discord OAuth2 credentials and website redirect settings
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
CLIENT_APP_URL=

# Politics and War API key (from https://politicsandwar.com/account)
PNW_API_KEY=your_pnw_api_key_here

# Politics and War test API key (from https://test.politicsandwar.com/account)
PNW_TEST_API_KEY=your_pnw_test_api_key_here

# Discord Guild (server) ID — only needed when using the bar3 HTTP API.
# Leave blank (or omit) to let the bot operate in any guild.
GUILD_ID=

# Role IDs
# Role assigned after successful /register verification
VERIFIED_ROLE_ID=your_verified_role_id_here

# bar3 client role ID
BAR3_CLIENT_ROLE_ID=your_bar3_client_role_id_here

# bar3 server role ID
BAR3_SERVER_ROLE_ID=your_bar3_server_role_id_here

# Optional extra access check for nation/alliance access:
# user must hold MEMBER_ROLE_ID in MEMBER_GUILD_ID
MEMBER_GUILD_ID=
MEMBER_ROLE_ID=

# MongoDB Atlas password for the glaernischgaming_db_user account
MONGODB_PASSWORD=your_mongodb_password_here

# bar3 HTTP API (used by the bar3 website to check Discord roles after OAuth login)
# If API_KEY is left blank the API server will not start.
API_KEY=your_secret_api_key_here
API_PORT=8080

# Discord IDs that bypass all command role requirements (comma-separated).
# Example: ADMIN_DISCORD_IDS=123456789012345678,987654321098765432
ADMIN_DISCORD_IDS=

# Enable privileged Guild Members intent when needed for member-join events.
# Keep unset/false if your app does not have the privileged intent approved.
DISCORD_ENABLE_GUILD_MEMBERS_INTENT=false

# PnW API key used for WebSocket subscription auth (war/nation create streams).
# Falls back to PNW_API_KEY when not set.
PW_SCAN_API_KEY=

# Optional: only expose alliance-tab/counter tracking for this alliance ID.
# Leave empty to allow all alliances.
COUNTER_TRACKED_ALLIANCE_ID=

# Optional scheduled reconnect interval for PnW subscriptions (minutes).
# Default is 180; minimum accepted value is 30.
PNW_SUBSCRIPTION_GATEWAY_RESET_MINUTES=180

# Optional: force slash-command sync on startup even when unchanged.
FORCE_DISCORD_COMMAND_SYNC=false

# Banking integration
BANKING_ENABLED=true
BANKING_SYNC_INTERVAL_SECONDS=120
OFFSHORE_ALLIANCE_ID=
ALLIANCE_BANK_ALLIANCE_ID=
# You can set a raw key value or env reference (example: env:ALLIANCE_BANK_API_KEY)
ALLIANCE_BANK_API_KEY_REF=
OFFSHORE_API_KEY_REF=
# Required offshore identifier for banking workflows
bot_key=

# Set to DEBUG to enable verbose logging.
# LOG_LEVEL=DEBUG
