# Primary backend API URL (defaults to https://bar3-server.onrender.com)
VUE_APP_API_URL=https://bar3-server.onrender.com

# Backwards-compatible alias for API URL. If VUE_APP_API_URL is set, it wins.
VUE_APP_SERVER_URL=https://bar3-server.onrender.com

# Optional dedicated auth/cookie endpoint base URL.
# Use this when frontend and backend are on different domains and Safari/iOS blocks
# third-party cookies. Point this to a same-site reverse proxy URL on your frontend
# domain that forwards /auth/* and /api/bot/* to the backend.
# If omitted, auth uses VUE_APP_API_URL.
# VUE_APP_AUTH_URL=https://your-frontend-domain.example.com/backend
# Optional: Google Docs source URL for the public Constitution page.
# When set, /constitution fetches this document through the backend, converts it to markdown, and renders it.
# VUE_APP_CONSTITUTION_GOOGLE_DOC_URL=https://docs.google.com/document/d/YOUR_DOC_ID/edit
