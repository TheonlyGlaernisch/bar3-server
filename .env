MONGODB_URI=mongodb+srv://glaernischgaming_db_user:64WKiJPOcvufLvWP@glaernisch.0o1fjdx.mongodb.net/?appName=Glaernisch
PORT=3000

# Discord OAuth2 — create an app at https://discord.com/developers/applications
# and add the redirect URI below to the OAuth2 Redirects list.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# flame_bot HTTP API — used to verify bar3_server role after Discord login.
# Set FLAME_BOT_API_URL to the base URL of the running flame_bot instance and
# FLAME_BOT_API_KEY to the same value as flame_bot's API_KEY env var.
FLAME_BOT_API_URL=http://localhost:8080
FLAME_BOT_API_KEY=

# Random secret used to sign the session cookie — set a long random string in production
SESSION_SECRET=bar3-change-me-in-production

# Admin panel password — set this to enable the /admin bot dashboard.
# If left empty the admin panel will display an error on the login page.
# Only share this with trusted server administrators.
ADMIN_PASSWORD=

# URL of the bar3-client SPA.  After a successful Discord OAuth2 login the
# browser is redirected here so the SPA can take over routing.
# This origin is also automatically added to the CORS allow-list so the SPA
# can make credentialled cross-origin requests (e.g. /auth/session).
# Example: CLIENT_APP_URL=https://bar3-client.onrender.com
# Leave empty to fall back to a same-server relative-path redirect.
CLIENT_APP_URL=

# Optional additional absolute post-login redirect targets for `returnTo`.
# Comma-separated list. Each entry must be an http/https URL origin or origin+path.
# Relative paths (e.g. /dashboard) are always allowed.
# Loopback localhost redirects are always allowed on any port (localhost, 127.0.0.1, [::1]).
# Example: DISCORD_RETURN_TO_ALLOWLIST=http://localhost:9876/callback,https://bar3-client.onrender.com
DISCORD_RETURN_TO_ALLOWLIST=

# CORS allowed origins — optional, comma-separated additional frontend origins
# permitted to make credentialled cross-origin requests to this server.
# CLIENT_APP_URL is always included automatically; you only need this if you
# have additional origins beyond CLIENT_APP_URL.
# Example: CLIENT_ORIGIN=https://staging.bar3-client.onrender.com,http://localhost:8080
# In development this can be left empty (falls back to wildcard *).
CLIENT_ORIGIN=

# Discord user IDs that bypass all command role requirements in flame_bot.
# When a logged-in user's Discord ID appears in this list, /auth/session returns
# isAdmin:true so the bar3-client can show admin-only UI (e.g. the bot tab).
# Set to the same value as ADMIN_DISCORD_IDS in the flame_bot .env.
# Example: ADMIN_DISCORD_IDS=123456789012345678,987654321098765432
ADMIN_DISCORD_IDS=

# PnW API key used by both bar3-server and flame_bot for nation stream/scan
# and bar3-server nation verification message sends. Falls back to PNW_API_KEY
# when this is unset.
PW_SCAN_API_KEY=
