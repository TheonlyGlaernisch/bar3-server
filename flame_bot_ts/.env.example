# Discord bot token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# Politics and War API key (from https://politicsandwar.com/account)
PNW_API_KEY=your_pnw_api_key_here

# Politics and War test API key (from https://test.politicsandwar.com/account)
PNW_TEST_API_KEY=your_pnw_test_api_key_here

# Discord Guild (server) ID — only needed when using the bar3 HTTP API.
# Leave blank (or omit) to let the bot operate in any guild.
GUILD_ID=

# Role IDs
# Role assigned after successful /register verification
VERIFIED_ROLE_ID=your_verified_role_id_here

# bar3 client role ID
BAR3_CLIENT_ROLE_ID=your_bar3_client_role_id_here

# bar3 server role ID
BAR3_SERVER_ROLE_ID=your_bar3_server_role_id_here

# MongoDB Atlas password for the glaernischgaming_db_user account
MONGODB_PASSWORD=your_mongodb_password_here

# bar3 HTTP API (used by the bar3 website to check Discord roles after OAuth login)
# If API_KEY is left blank the API server will not start.
API_KEY=your_secret_api_key_here
API_PORT=8080

# Discord IDs that bypass all command role requirements (comma-separated).
# Example: ADMIN_DISCORD_IDS=123456789012345678,987654321098765432
ADMIN_DISCORD_IDS=

# PnW API key used by both bar3-server and flame_bot to scan for new nations.
# Falls back to PNW_API_KEY when not set.
PW_SCAN_API_KEY=

# Set to DEBUG to enable verbose logging.
# LOG_LEVEL=DEBUG
