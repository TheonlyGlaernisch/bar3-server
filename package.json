{
  "name": "trf-tech-server",
  "version": "1.1.1",
  "description": "The local server for Bar 3",
  "main": "./build/server/index.js",
  "bin": "./build/server/index.js",
  "scripts": {
    "start": "sh ./scripts/run-both.sh",
    "start:server": "node ./build/server/index.js",
    "start:bot": "node ./discord-bot/build/src/index.js",
    "dev": "nodemon ./build/server/index.js --debug",
    "verbose": "node ./build/server/index.js --debug",
    "postinstall": "npm --prefix discord-bot install && npm --prefix bar3-client install",
    "prebuild": "shx rm -rf ./build/*",
    "build": "npm run build:server && npm run build:bot && npm run build:client",
    "build:server": "tsc && shx cp ./PRIVACY.md ./build/PRIVACY.md",
    "build:bot": "npm --prefix discord-bot run build",
    "build:client": "npm --prefix bar3-client run build",
    "pack": "npm run build && npx pkg . --target node12-win-x86,node12-linux,node12-macos-x64",
    "postpack": "shx mkdir -p dist && shx mv trf-tech-server-* dist/",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "bsnk-dev",
  "license": "MIT",
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie": "^0.6.0",
    "@types/cookie-signature": "^1.1.2",
    "@types/cors": "^2.8.9",
    "@types/express": "^4.17.11",
    "@types/express-session": "^1.18.2",
    "@types/superagent": "^4.1.0",
    "@types/ws": "^8.18.0",
    "@types/yargs": "^16.0.0",
    "@typescript-eslint/eslint-plugin": "^4.14.1",
    "@typescript-eslint/parser": "^4.13.0",
    "bcrypt": "^6.0.0",
    "chalk": "^4.1.0",
    "cookie-signature": "^1.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "eslint": "^7.17.0",
    "eslint-config-google": "^0.14.0",
    "express": "^4.17.1",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.19.0",
    "juice": "^11.1.1",
    "mongodb": "3.7.0",
    "mongoose": "^6.10.0",
    "node-html-parser": "^3.3.5",
    "nodemon": "^3.1.14",
    "open": "^7.3.1",
    "shx": "^0.3.3",
    "superagent": "^6.1.0",
    "typescript": "^5.3.3",
    "ws": "^8.18.1",
    "yargs": "^16.2.0",
    "web-push": "^3.6.7",
    "@types/web-push": "^3.6.4"
  },
  "pkg": {
    "assets": [
      "./public/**/*",
      "./package.json",
      "./PRIVACY.md"
    ]
  }
}
